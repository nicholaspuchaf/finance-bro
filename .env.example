# Backend
# Configure as portas em .env.conf, separado das credenciais deste arquivo.
# No desenvolvimento sem Docker, mantenha LOCAL_ONLY=true.
# O Compose sobrescreve para false e publica somente em 127.0.0.1.
LOCAL_ONLY=true
# FRONTEND_DIST é opcional no desenvolvimento; o container já define o build.
# Opcional: sem DATABASE_URL, usa backend/data/finance_bro.db.
FRONTEND_ORIGIN=http://localhost:5173

# Pluggy — keep these credentials on the backend only.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_API_URL=https://api.pluggy.ai

# OpenAI — optional until AI categorization is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
